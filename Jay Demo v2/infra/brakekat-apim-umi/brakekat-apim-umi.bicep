// SUPERSEDED by uc-agent-gateway/azure/bicep/main.bicep (+ brakekat.bicepparam). Kept as the record of the first deploy.
// BrakeKat demo: Foundry agent -> APIM (user-assigned managed identity) -> Databricks UC functions MCP.
// Models the IMH Azure Agents Control Plane pattern (APIM + UMI) with UC as the only data governance layer.
// No secrets: APIM authenticates to Databricks with the UMI; callers use an APIM subscription key read from the portal.
targetScope = 'resourceGroup'

param location string = 'westus3'
param prefix string = 'imh-uc'
param publisherEmail string = 'jay@brakekat.com'
param databricksHost string = 'adb-2813105879250022.2.azuredatabricks.net'
param ucCatalog string = 'imh_demo'
param ucSchema string = 'clinical'
@description('Calls per minute per subscription key. Lower it (e.g. 3) live to demo a 429.')
param callsPerMinute int = 30

// Well-known Azure Databricks first-party resource (application) ID.
var databricksResource = '2ff814a6-3304-4ab8-85cb-cd0e6f879c1d'
var suffix = uniqueString(resourceGroup().id, prefix)

resource umi 'Microsoft.ManagedIdentity/userAssignedIdentities@2023-01-31' = {
  name: 'umi-${prefix}-agent'
  location: location
}

resource law 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: 'law-${prefix}-${suffix}'
  location: location
  properties: {
    sku: { name: 'PerGB2018' }
    retentionInDays: 30
  }
}

resource apim 'Microsoft.ApiManagement/service@2024-05-01' = {
  name: 'apim-${prefix}-${suffix}'
  location: location
  sku: { name: 'BasicV2', capacity: 1 }
  identity: {
    type: 'UserAssigned'
    userAssignedIdentities: { '${umi.id}': {} }
  }
  properties: {
    publisherEmail: publisherEmail
    publisherName: 'IMH UC demo (synthetic)'
  }
}

resource api 'Microsoft.ApiManagement/service/apis@2024-05-01' = {
  parent: apim
  name: 'imh-uc-functions-mcp'
  properties: {
    displayName: 'IMH UC functions MCP (via UMI)'
    path: 'uc'
    protocols: ['https']
    serviceUrl: 'https://${databricksHost}'
    subscriptionRequired: true
    subscriptionKeyParameterNames: { header: 'Ocp-Apim-Subscription-Key', query: 'subscription-key' }
  }
}

resource opPost 'Microsoft.ApiManagement/service/apis/operations@2024-05-01' = {
  parent: api
  name: 'mcp-post'
  properties: { displayName: 'MCP POST', method: 'POST', urlTemplate: '/mcp', responses: [] }
}

resource opGet 'Microsoft.ApiManagement/service/apis/operations@2024-05-01' = {
  parent: api
  name: 'mcp-get'
  properties: { displayName: 'MCP GET', method: 'GET', urlTemplate: '/mcp', responses: [] }
}

resource opDelete 'Microsoft.ApiManagement/service/apis/operations@2024-05-01' = {
  parent: api
  name: 'mcp-delete'
  properties: { displayName: 'MCP DELETE', method: 'DELETE', urlTemplate: '/mcp', responses: [] }
}

var policyTemplate = '''
<policies>
  <inbound>
    <base />
    <rate-limit-by-key calls="__CALLS__" renewal-period="60" counter-key="@(context.Subscription.Id)" />
    <set-variable name="correlationId" value="@(context.RequestId.ToString())" />
    <set-header name="x-imh-correlation-id" exists-action="override"><value>@((string)context.Variables["correlationId"])</value></set-header>
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <rewrite-uri template="/api/2.0/mcp/functions/__CATALOG__/__SCHEMA__" copy-unmatched-params="false" />
    <authentication-managed-identity resource="__RESOURCE__" client-id="__CLIENT_ID__" ignore-error="false" />
  </inbound>
  <backend><forward-request timeout="120" buffer-response="false" /></backend>
  <outbound>
    <set-header name="x-imh-correlation-id" exists-action="override"><value>@((string)context.Variables["correlationId"])</value></set-header>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
'''
var policyXml = replace(replace(replace(replace(replace(policyTemplate,
  '__CALLS__', string(callsPerMinute)), '__CATALOG__', ucCatalog), '__SCHEMA__', ucSchema),
  '__RESOURCE__', databricksResource), '__CLIENT_ID__', umi.properties.clientId)

resource policy 'Microsoft.ApiManagement/service/apis/policies@2024-05-01' = {
  parent: api
  name: 'policy'
  properties: { format: 'rawxml', value: policyXml }
  dependsOn: [opPost, opGet, opDelete]
}

// Key is generated by APIM; read it in the portal (APIM > Subscriptions > show key). Never written to disk.
resource sub 'Microsoft.ApiManagement/service/subscriptions@2024-05-01' = {
  parent: apim
  name: 'foundry-imh-uc-agent'
  properties: {
    displayName: 'Foundry agent imh-uc-apim-umi-agent'
    scope: '/apis/${api.name}'
    state: 'active'
  }
}

resource diag 'Microsoft.Insights/diagnosticSettings@2021-05-01-preview' = {
  name: 'to-law'
  scope: apim
  properties: {
    workspaceId: law.id
    logAnalyticsDestinationType: 'Dedicated'
    logs: [{ category: 'GatewayLogs', enabled: true }]
    metrics: [{ category: 'AllMetrics', enabled: true }]
  }
}

output apimName string = apim.name
output mcpUrl string = 'https://${apim.name}.azure-api.net/uc/mcp'
output umiName string = umi.name
output umiClientId string = umi.properties.clientId
output umiPrincipalId string = umi.properties.principalId
output logAnalyticsWorkspace string = law.name
