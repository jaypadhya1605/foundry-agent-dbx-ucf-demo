-- Row filter: PHI-full sees all, analysts see all (masked), SLC clinicians see SLC only.
CREATE OR REPLACE FUNCTION fac_filter(facility STRING)
RETURN is_account_group_member('${phi_full}')
    OR is_account_group_member('${analyst}')
    OR (facility = 'SLC' AND is_account_group_member('${clinician_slc}'));

CREATE OR REPLACE FUNCTION mask_ssn(ssn STRING)
RETURN CASE WHEN is_account_group_member('${phi_full}') THEN ssn
            ELSE CONCAT('***-**-', RIGHT(ssn, 4)) END;

CREATE OR REPLACE FUNCTION mask_name(name STRING)
RETURN CASE WHEN is_account_group_member('${phi_full}') OR is_account_group_member('${clinician_slc}') THEN name
            ELSE 'REDACTED' END;

ALTER TABLE patients SET ROW FILTER fac_filter ON (facility);
ALTER TABLE patients ALTER COLUMN ssn  SET MASK mask_ssn;
ALTER TABLE patients ALTER COLUMN name SET MASK mask_name;

-- Exposed as an MCP tool by /api/2.0/mcp/functions/${catalog}/${schema}. Runs as the caller, so filters and masks apply.
CREATE OR REPLACE FUNCTION get_patients(fac STRING DEFAULT NULL COMMENT 'Facility code, e.g. SLC. NULL = all facilities the caller may see.')
RETURNS TABLE (patient_id STRING, name STRING, ssn STRING, facility STRING, diagnosis STRING)
COMMENT 'Patients visible to the caller under Unity Catalog row filters and column masks.'
RETURN
  SELECT patient_id, name, ssn, facility, diagnosis
  FROM ${catalog}.${schema}.patients
  WHERE fac IS NULL OR facility = upper(fac);

-- Row cap enforced inside Unity Catalog (defense in depth with the APIM /uc-limited row cap).
-- Whatever the agent asks for, at most 10 rows come back; default 5.
CREATE OR REPLACE FUNCTION get_patients_limited(
  fac      STRING DEFAULT NULL COMMENT 'Facility code, e.g. SLC. NULL = all facilities the caller may see.',
  max_rows INT    DEFAULT 5    COMMENT 'Rows to return (1-10). Larger values are capped at 10.')
RETURNS TABLE (patient_id STRING, name STRING, ssn STRING, facility STRING, diagnosis STRING)
COMMENT 'Like get_patients, but Unity Catalog caps the result at 10 rows. Filters and masks still apply.'
RETURN
  SELECT patient_id, name, ssn, facility, diagnosis
  FROM (
    SELECT patient_id, name, ssn, facility, diagnosis,
           row_number() OVER (ORDER BY patient_id) AS rn
    FROM ${catalog}.${schema}.patients
    WHERE fac IS NULL OR facility = upper(fac)
  )
  -- Filter in WHERE: Databricks cannot resolve function parameters inside QUALIFY.
  WHERE rn <= least(greatest(coalesce(max_rows, 5), 1), 10);
