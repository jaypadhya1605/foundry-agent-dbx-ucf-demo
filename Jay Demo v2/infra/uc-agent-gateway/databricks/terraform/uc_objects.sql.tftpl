-- UC agent gateway demo objects. SYNTHETIC DATA ONLY. Re-running replaces the demo table.
-- Rendered by Terraform (templatefile) and run once by the setup job on a SQL warehouse.

USE CATALOG ${catalog};
USE SCHEMA ${schema};

CREATE OR REPLACE TABLE patients (
  patient_id STRING,
  name       STRING,
  dob        DATE,
  ssn        STRING,
  facility   STRING,
  diagnosis  STRING
);

