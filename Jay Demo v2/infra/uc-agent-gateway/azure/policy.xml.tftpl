<policies>
  <inbound>
    <base />
    <rate-limit-by-key calls="${calls}" renewal-period="60" counter-key="@(context.Subscription.Id)" />
    <set-variable name="correlationId" value="@(context.RequestId.ToString())" />
    <set-header name="x-imh-correlation-id" exists-action="override"><value>@((string)context.Variables["correlationId"])</value></set-header>
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <rewrite-uri template="${rewrite}" copy-unmatched-params="false" />
    <authentication-managed-identity resource="${resource}" client-id="${client_id}" ignore-error="false" />
  </inbound>
  <backend><forward-request timeout="120" buffer-response="false" /></backend>
  <outbound>
    <set-header name="x-imh-correlation-id" exists-action="override"><value>@((string)context.Variables["correlationId"])</value></set-header>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
